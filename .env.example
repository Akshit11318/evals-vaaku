# Copy to .env and replace the placeholders. Never commit .env.

# The bench is reached through an SSH tunnel to 127.0.0.1, so no token is required.
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_AUTH_DISABLED=1

DATA_DIR=data
OUTPUT_DIR=outputs
DB_PATH=outputs/benchmark.db
LOG_LEVEL=INFO

# Needed only for gated datasets. FLEURS does not need it.
HF_TOKEN=

PREFER_GPU=1
ALLOW_CPU_FALLBACK=1
WHISPER_SMALL_MIN_FREE_MB=1200
WHISPER_MEDIUM_MIN_FREE_MB=3500
INDIC_CONFORMER_MIN_FREE_MB=4000
MMS_MIN_FREE_MB=4500
INDIC_DECODER=rnnt
MAX_SAMPLES=200

HF_HOME=
HUGGINGFACE_HUB_CACHE=
HF_DATASETS_CACHE=

# Used by scripts/deploy_aws.sh. Do not put real values in git.
AWS_HOST=
AWS_USER=
AWS_PEM_PATH=
AWS_PORT=22
GITHUB_REPO=
DASHBOARD_URL=
